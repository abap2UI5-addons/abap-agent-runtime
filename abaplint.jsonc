{
  // NetWeaver 7.02: `npm run downport` rewrites src/ in place with this
  // config, then it lints the result - never commit downported source to
  // main. publish-702 (`npm run auto_downport`) writes the result to the 702
  // branch. headless-frontend resolves from its own 702 branch, which its
  // publish-702 workflow generates the same way. Package 04 (ABAP Cloud
  // entry) is not a 7.02 target.
  "global": {
    "files": "/src/**/*.*",
    "exclude": ["/src/04/"]
  },
  "dependencies": [
    {
      "url": "https://github.com/open-abap/open-abap-core",
      "folder": "/../../.abaplint-deps/open-abap-core",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5/abap2UI5",
      "branch": "702",
      "folder": "/../../.abaplint-deps/abap2UI5-702",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5/headless-frontend",
      "branch": "702",
      "folder": "/../../.abaplint-deps/headless-frontend-702",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v702",
    "errorNamespace": "."
  },
  "rules": {
    "downport": true,
    "definitions_top": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "xml_consistency": true
  }
}
