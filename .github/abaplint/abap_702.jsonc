{
  // NetWeaver 7.02: `npm run downport` rewrites src/ in place with this
  // config, then it lints the result - CI only, never commit downported
  // source. The headless-frontend dependency is modern ABAP as well, so the
  // ABAP_702 workflow clones it into src/zz_headless_frontend first and the
  // downport rewrites both. Package 04 (ABAP Cloud entry) is not a 7.02
  // target.
  "global": {
    "files": "/../../src/**/*.*",
    "exclude": ["/src/04/"]
  },
  "dependencies": [
    {
      "url": "https://github.com/open-abap/open-abap-core",
      "folder": "/../../.abaplint-deps/open-abap-core",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5/abap2UI5",
      "branch": "702",
      "folder": "/../../.abaplint-deps/abap2UI5-702",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v702",
    "errorNamespace": "."
  },
  "rules": {
    "downport": true,
    "definitions_top": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "xml_consistency": true
  }
}
